# Get your key from https://aistudio.google.com/app/apikey
# IMPORTANT: this file must never be committed to git (see .gitignore)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask secret key - generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key

# Set to True only for local development, never in production
FLASK_DEBUG=False

# Rate limiter storage backend (see .env.example for details)
RATELIMIT_STORAGE_URI=memory://

# Reverse proxy / TLS. Left as-is here for the plain `python app.py` Quick
# Start (no TLS on localhost); docker-compose.yml overrides both of these
# to True for the `web` service since that path sits behind nginx.
BEHIND_PROXY=False
SESSION_COOKIE_SECURE=False

# Account features (see .env.example for details on each).
# Left blank here for local dev: emails get logged instead of sent, and
# Google sign-in stays hidden until GOOGLE_CLIENT_ID/SECRET are set.
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_FROM=Quick Aid <no-reply@quickaid.example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
