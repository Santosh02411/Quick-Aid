# Copy this file to .env and fill in real values. Never commit .env itself.

# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask secret key - generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key

# Set to True only for local development, never in production
FLASK_DEBUG=False

# Rate limiter storage backend. Defaults to in-memory, which only tracks
# limits correctly for a single process. Any deployment running more than
# one gunicorn worker or more than one instance (see Procfile: -w 2) needs
# a shared backend or each worker enforces its own separate limit. Point
# this at Redis in production, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Set True only when this process sits behind a reverse proxy you control
# (e.g. the nginx service in docker-compose.yml) that terminates TLS and
# sets X-Forwarded-*. Do NOT enable this if the app is reachable directly -
# it lets whoever connects spoof their own IP/scheme. See app.py.
BEHIND_PROXY=False

# Whether the session cookie requires HTTPS. Leave False for the plain
# `python app.py` Quick Start (no TLS on localhost). docker-compose.yml
# overrides this to True for the `web` service, since that path always
# sits behind nginx's TLS termination - see its comments for details.
SESSION_COOKIE_SECURE=False

# Base URL used to build links in password-reset / email-verification
# emails, e.g. https://quickaid.example.com (no trailing slash). If unset,
# falls back to the incoming request's own host - fine for local dev, but
# set this explicitly in production (especially behind a proxy/CDN).
APP_BASE_URL=

# --- TLS certificate (production) -------------------------------------------
# Not an env var - this is about nginx/certs/fullchain.pem + privkey.pem,
# which the nginx service in docker-compose.yml uses for HTTPS. There's no
# credential to paste here, but since it blocks going live, the steps:
#   1. You need a domain name pointed at your server (an A record in your
#      domain's DNS settings, e.g. from Namecheap/Cloudflare/etc, pointing
#      to your server's public IP). Let's Encrypt can't issue a cert for
#      "localhost" or an IP address - only for a real domain you control.
#   2. Get a free cert from Let's Encrypt via certbot:
#        https://certbot.eff.org/instructions -> choose "Nginx" and your OS
#      Either run certbot on the host and copy the resulting
#      /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem into
#      nginx/certs/, or run certbot in its own container sharing that
#      volume. nginx/nginx.conf already serves /.well-known/acme-challenge/
#      on port 80 for certbot's HTTP-01 domain-ownership check.
#   3. Certs expire every 90 days - set up the renewal cron job certbot's
#      installer offers (`certbot renew` on a timer), or you'll need to
#      repeat step 2 manually before each expiry.
#   4. Until then, ./nginx/generate-dev-certs.sh (self-signed) is already
#      in place and works fine for local testing - browsers just show a
#      trust warning you can click through.

# --- Outgoing email (password reset, email verification) -------------------
# If SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD are left blank, emails are just
# logged instead of sent - handy for local dev, but you need real SMTP
# credentials for reset/verification links to actually reach anyone.
#
# OPTION A - Gmail (quickest, fine for low volume / testing):
#   1. Go to https://myaccount.google.com/apppasswords
#      (requires 2-Step Verification to be turned on for the Google account -
#      turn it on first at https://myaccount.google.com/security if needed)
#   2. Create an app password: enter any name (e.g. "Quick Aid"), click
#      Create. Google shows you a 16-character password - copy it now, you
#      can't view it again later.
#   3. Set below:
#        SMTP_HOST=smtp.gmail.com
#        SMTP_PORT=587
#        SMTP_USERNAME=youraddress@gmail.com
#        SMTP_PASSWORD=<the 16-character app password, no spaces>
#        SMTP_USE_TLS=True
#   Gmail caps free accounts at ~500 sends/day - fine for dev/small use,
#   not for production volume.
#
# OPTION B - a transactional email provider (better for production):
#   SendGrid (https://sendgrid.com), Mailgun (https://mailgun.com), Postmark
#   (https://postmarkapp.com), and Amazon SES all have free/cheap tiers and
#   give you an SMTP host/username/password after signup + verifying a
#   sending domain. Plug their values into the same 5 fields below - the
#   app doesn't care which provider you use, only that it speaks SMTP.
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_FROM=Quick Aid <no-reply@quickaid.example.com>

# --- Optional Google OAuth/SSO ----------------------------------------------
# Leave both blank to disable Google sign-in entirely (the button is hidden
# on the login/register pages).
#
# To enable "Continue with Google":
#   1. Go to https://console.cloud.google.com/ and create a project (or pick
#      an existing one) from the project dropdown at the top of the page.
#   2. Go to https://console.cloud.google.com/apis/credentials/consent
#      (OAuth consent screen) and configure it: choose "External" (unless
#      you have a Google Workspace org and want "Internal"), fill in the app
#      name, your support email, and add your own email under test users if
#      the app is still in "Testing" publishing status (that's fine for
#      dev - it just limits sign-in to accounts you list).
#   3. Go to https://console.cloud.google.com/apis/credentials, click
#      "+ Create Credentials" -> "OAuth client ID", application type
#      "Web application".
#   4. Under "Authorized redirect URIs", add:
#        <APP_BASE_URL>/login/google/callback
#      e.g. https://quickaid.example.com/login/google/callback in
#      production, or http://localhost:5000/login/google/callback for
#      local testing (Google allows http:// only for localhost).
#   5. Click Create - Google shows you a Client ID and Client Secret. Copy
#      both into the two fields below.
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
