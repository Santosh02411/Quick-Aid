# =============================================================================
#  Quick Aid - environment configuration
# =============================================================================
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values marked  [REQUIRED]  (and any [OPTIONAL] ones you want)
#  3. Restart the app.
#
#  NEVER commit .env to git - it holds secrets (it is already in .gitignore).
#  Real environment variables (Docker, Heroku, CI) override values in this file.
#  Booleans accept: True / False (also 1 / 0, yes / no).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CORE  [REQUIRED]
# -----------------------------------------------------------------------------

# Google Gemini API key - powers image analysis and the symptom checker.
#   Where to get it : https://aistudio.google.com/app/apikey  ("Create API key")
#   What to paste   : the key string, starts with "AIza..."
#   If left as the placeholder / empty: the app still runs in BASIC MODE
#   (simple rule-based heuristics, no AI).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for photo and symptom analysis. OPTIONAL.
#   Default (blank): gemini-flash-latest - fast and cheap, good accuracy.
#   For the best accuracy you can set a Pro model, e.g. gemini-pro-latest
#   (slower, costs more per check). Model names: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-pro-latest

# Flask secret key - signs login sessions and CSRF tokens.
#   Generate one by running:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   Paste the 64-character output here. Keep it private and keep it STABLE:
#   if it changes (or is missing) every user is logged out on restart.
SECRET_KEY=change_this_to_a_random_secret_key

# Debug mode. True = auto-reload + interactive debugger (local dev ONLY).
#   Always False in production - debug mode allows remote code execution.
FLASK_DEBUG=False


# -----------------------------------------------------------------------------
# 2. SERVER / DEPLOYMENT  [OPTIONAL - defaults are fine for local `python run.py`]
# -----------------------------------------------------------------------------

# Region for emergency numbers shown in the app and written into AI advice.
#   IN = India (112 / ambulance 108)   US   CA   UK   EU   AU   INTL (generic)
APP_REGION=IN

# Port the dev server (run.py) listens on. Gunicorn/Docker/Heroku set their own.
PORT=5000

# Public base URL used to build links inside password-reset / verification
# emails and the Google OAuth redirect. No trailing slash.
#   Local dev  : leave blank (falls back to the request's own host)
#   Production : https://quickaid.yourdomain.com
APP_BASE_URL=

# Set True ONLY when the app sits behind a reverse proxy you control
# (e.g. the nginx service in docker-compose.yml) that sets X-Forwarded-* headers.
# Never enable it if the app is reachable directly - clients could spoof their IP.
#   Plain `python run.py` : False      docker compose : set to True automatically
BEHIND_PROXY=False

# Send the session cookie over HTTPS only.
#   Plain http://localhost : False (otherwise you cannot stay logged in)
#   Any real HTTPS deployment : True  (docker-compose.yml forces True)
SESSION_COOKIE_SECURE=False

# Rate-limiter storage (flask-limiter).
#   memory://              - fine for a single process / local dev
#   redis://localhost:6379 - REQUIRED in production with more than one gunicorn
#                            worker or instance, otherwise each worker counts
#                            limits separately. e.g. redis://:password@host:6379/0
RATELIMIT_STORAGE_URI=memory://


# -----------------------------------------------------------------------------
# 3. STORAGE & LOGGING  [OPTIONAL - uncomment only to change the defaults]
# -----------------------------------------------------------------------------

# SQLite database file. Default: <project>/data/quickaid.db
#   (Docker already sets this to /app/data/quickaid.db and mounts a volume.)
# DATABASE_PATH=/absolute/path/to/quickaid.db

# Folder for temporary image uploads (deleted right after analysis).
#   Default: <project>/uploads
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Log folder (rotating app.log, 5 MB x 5 files). Default: <project>/logs
# LOG_DIR=/absolute/path/to/logs

# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 4. OUTGOING EMAIL (password reset + email verification)  [OPTIONAL]
# -----------------------------------------------------------------------------
# If SMTP_HOST, SMTP_USERNAME and SMTP_PASSWORD are ALL filled in, real emails
# are sent. If any is blank, emails are only written to the log (copy the link
# out of logs/app.log) - perfect for local development.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USE_TLS=True
#   SMTP_USERNAME=<your gmail address>
#   SMTP_PASSWORD=<16-char App Password - NOT your normal Gmail password>
#     create one at https://myaccount.google.com/apppasswords
#     (needs 2-Step Verification turned on for the Google account)
# Other providers (Brevo, SendGrid, Mailgun, Zoho, Outlook...): copy the SMTP
# host / port / username / password from the provider's dashboard.

# SMTP server hostname, e.g. smtp.gmail.com
SMTP_HOST=

# 587 = STARTTLS (use with SMTP_USE_TLS=True, most common)
# 465 = implicit SSL
SMTP_PORT=587

# Login for the SMTP server (usually the full email address)
SMTP_USERNAME=

# Password / app password / API key for that login
SMTP_PASSWORD=

# True for port 587 (STARTTLS), False if your provider says otherwise
SMTP_USE_TLS=True

# "From" header on outgoing mail. Must be an address your provider allows
# you to send as (many reject unverified senders).
#   Format: Display Name <address@domain>
MAIL_FROM=Quick Aid <no-reply@quickaid.example.com>


# -----------------------------------------------------------------------------
# 5. GOOGLE SIGN-IN (OAuth / SSO)  [OPTIONAL]
# -----------------------------------------------------------------------------
# Leave BOTH blank to disable - the "Continue with Google" button is hidden.
# To enable:
#   1. Open https://console.cloud.google.com/apis/credentials
#   2. Create credentials -> OAuth client ID -> Application type: "Web application"
#      (first time: configure the OAuth consent screen)
#   3. Under "Authorized redirect URIs" add EXACTLY:
#        local      : http://localhost:5000/login/google/callback
#        production : https://quickaid.yourdomain.com/login/google/callback
#   4. Copy the Client ID and Client secret below.
#   (Set APP_BASE_URL above for production so the redirect URI matches.)

# Looks like 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Looks like GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=
