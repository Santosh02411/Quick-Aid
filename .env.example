# Copy this file to .env and fill in real values. Never commit .env itself.

# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Flask secret key - generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key

# Set to True only for local development, never in production
FLASK_DEBUG=False

# Rate limiter storage backend. Defaults to in-memory, which only tracks
# limits correctly for a single process. Any deployment running more than
# one gunicorn worker or more than one instance (see Procfile: -w 2) needs
# a shared backend or each worker enforces its own separate limit. Point
# this at Redis in production, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://

# Set True only when this process sits behind a reverse proxy you control
# (e.g. the nginx service in docker-compose.yml) that terminates TLS and
# sets X-Forwarded-*. Do NOT enable this if the app is reachable directly -
# it lets whoever connects spoof their own IP/scheme. See app.py.
BEHIND_PROXY=False

# Whether the session cookie requires HTTPS. Leave False for the plain
# `python app.py` Quick Start (no TLS on localhost). docker-compose.yml
# overrides this to True for the `web` service, since that path always
# sits behind nginx's TLS termination - see its comments for details.
SESSION_COOKIE_SECURE=False

# Base URL used to build links in password-reset / email-verification
# emails, e.g. https://quickaid.example.com (no trailing slash). If unset,
# falls back to the incoming request's own host - fine for local dev, but
# set this explicitly in production (especially behind a proxy/CDN).
APP_BASE_URL=

# --- Outgoing email (password reset, email verification) -------------------
# If SMTP_HOST/SMTP_USERNAME/SMTP_PASSWORD are left blank, emails are just
# logged instead of sent - handy for local dev, but you need real SMTP
# credentials for reset/verification links to actually reach anyone.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_FROM=Quick Aid <no-reply@quickaid.example.com>

# --- Optional Google OAuth/SSO ----------------------------------------------
# Leave both blank to disable Google sign-in entirely (the button is hidden
# on the login/register pages). To enable: create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials with an authorized
# redirect URI of <APP_BASE_URL>/login/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
