# =============================================================================
#  Quick Aid - environment configuration
# =============================================================================
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values marked  [REQUIRED]  (and any [OPTIONAL] ones you want)
#  3. Restart the app.
#
#  NEVER commit .env to git - it holds secrets (it is already in .gitignore).
#  Real environment variables (Docker, Heroku, CI) override values in this file.
#  Booleans accept: True / False (also 1 / 0, yes / no).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CORE  [REQUIRED]
# -----------------------------------------------------------------------------

# Google Gemini API key - powers image analysis and the symptom checker.
#   Where to get it : https://aistudio.google.com/app/apikey  ("Create API key")
#   What to paste   : the key string, starts with "AIza..."
#   If left as the placeholder / empty: the app still runs in BASIC MODE
#   (simple rule-based heuristics, no AI).
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for photo and symptom analysis. OPTIONAL.
#   Default (blank): gemini-flash-latest - fast and cheap, good accuracy.
#   For the best accuracy you can set a Pro model, e.g. gemini-pro-latest
#   (slower, costs more per check). Model names: https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-pro-latest

# Flask secret key - signs login sessions and CSRF tokens.
#   Generate one by running:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   Paste the 64-character output here. Keep it private and keep it STABLE:
#   if it changes (or is missing) every user is logged out on restart.
SECRET_KEY=change_this_to_a_random_secret_key

# Encryption key for stored chat messages, symptom-interview answers and saved analysis
# details (encrypted before they are written to the database).
#   Leave blank: a key is derived from SECRET_KEY (fine for most setups).
#   Production: set your own long random value so the two can be rotated separately:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   KEEP IT STABLE. If it changes, existing chats and saved details can no longer be
#   read (they show as unavailable) and cannot be recovered. Back it up with your database.
CHAT_ENCRYPTION_KEY=

# Debug mode. True = auto-reload + interactive debugger (local dev ONLY).
#   Always False in production - debug mode allows remote code execution.
FLASK_DEBUG=False


# -----------------------------------------------------------------------------
# 2. SERVER / DEPLOYMENT  [OPTIONAL - defaults are fine for local `python run.py`]
# -----------------------------------------------------------------------------

# Region for emergency numbers shown in the app and written into AI advice.
#   IN = India (112 / ambulance 108)   US   CA   UK   EU   AU   INTL (generic)
APP_REGION=IN

# Port the dev server (run.py) listens on. Gunicorn/Docker/Heroku set their own.
PORT=5000

# Public base URL used to build links inside password-reset / verification
# emails and the Google OAuth redirect. No trailing slash.
#   Local dev  : leave blank (falls back to the request's own host)
#   Production : https://quickaid.yourdomain.com
APP_BASE_URL=

# Set True ONLY when the app sits behind a reverse proxy you control
# (e.g. the nginx service in docker-compose.yml) that sets X-Forwarded-* headers.
# Never enable it if the app is reachable directly - clients could spoof their IP.
#   Plain `python run.py` : False      docker compose : set to True automatically
BEHIND_PROXY=False

# Send the session cookie over HTTPS only.
#   Plain http://localhost : False (otherwise you cannot stay logged in)
#   Any real HTTPS deployment : True  (docker-compose.yml forces True)
SESSION_COOKIE_SECURE=False

# Rate-limiter storage (flask-limiter).
#   memory://              - fine for a single process / local dev
#   redis://localhost:6379 - REQUIRED in production with more than one gunicorn
#                            worker or instance, otherwise each worker counts
#                            limits separately. e.g. redis://:password@host:6379/0
RATELIMIT_STORAGE_URI=memory://


# -----------------------------------------------------------------------------
# 3. STORAGE & LOGGING  [OPTIONAL - uncomment only to change the defaults]
# -----------------------------------------------------------------------------

# SQLite database file. Default: <project>/data/quickaid.db
#   (Docker already sets this to /app/data/quickaid.db and mounts a volume.)
# DATABASE_PATH=/absolute/path/to/quickaid.db

# Folder for temporary image uploads (deleted right after analysis).
#   Default: <project>/uploads
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Log folder (rotating app.log, 5 MB x 5 files). Default: <project>/logs
# LOG_DIR=/absolute/path/to/logs

# Log verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: INFO
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# 4. OUTGOING EMAIL (password reset + email verification)  [OPTIONAL]
# -----------------------------------------------------------------------------
# If SMTP_HOST, SMTP_USERNAME and SMTP_PASSWORD are ALL filled in, real emails
# are sent. If any is blank, emails are only written to the log (copy the link
# out of logs/app.log) - perfect for local development.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587   SMTP_USE_TLS=True
#   SMTP_USERNAME=<your gmail address>
#   SMTP_PASSWORD=<16-char App Password - NOT your normal Gmail password>
#     create one at https://myaccount.google.com/apppasswords
#     (needs 2-Step Verification turned on for the Google account)
# Other providers (Brevo, SendGrid, Mailgun, Zoho, Outlook...): copy the SMTP
# host / port / username / password from the provider's dashboard.

# SMTP server hostname, e.g. smtp.gmail.com
SMTP_HOST=

# 587 = STARTTLS (use with SMTP_USE_TLS=True, most common)
# 465 = implicit SSL
SMTP_PORT=587

# Login for the SMTP server (usually the full email address)
SMTP_USERNAME=

# Password / app password / API key for that login
SMTP_PASSWORD=

# True for port 587 (STARTTLS), False if your provider says otherwise
SMTP_USE_TLS=True

# "From" header on outgoing mail. Must be an address your provider allows
# you to send as (many reject unverified senders).
#   Format: Display Name <address@domain>
MAIL_FROM=Quick Aid <no-reply@quickaid.example.com>


# -----------------------------------------------------------------------------
# 5. GOOGLE SIGN-IN (OAuth / SSO)  [OPTIONAL]
# -----------------------------------------------------------------------------
# Leave BOTH blank to disable - the "Continue with Google" button is hidden.
# To enable:
#   1. Open https://console.cloud.google.com/apis/credentials
#   2. Create credentials -> OAuth client ID -> Application type: "Web application"
#      (first time: configure the OAuth consent screen)
#   3. Under "Authorized redirect URIs" add EXACTLY:
#        local      : http://localhost:5000/login/google/callback
#        production : https://quickaid.yourdomain.com/login/google/callback
#   4. Copy the Client ID and Client secret below.
#   (Set APP_BASE_URL above for production so the redirect URI matches.)

# Looks like 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Looks like GOCSPX-xxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 6. ADMIN ACCESS  [OPTIONAL]
# -----------------------------------------------------------------------------
# Usernames listed here can open two internal dashboards: /admin/evaluation (how well the medical AI performs) and
# /admin/users (account management - reset a locked-out user's 2FA, sign a device out, email a password reset,
# delete an account; see README's "Admin: managing users"). Everyone else, signed in or not, gets a "not found"
# page on both, so their existence is not revealed. Comma-separated, case-insensitive. Blank = nobody is an admin.
# Register the account normally first, THEN add its username here and restart - never through the sign-up page.
# The same actions are also available from the terminal without this set at all: python -m quickaid.core.accounts_cli
ADMIN_USERNAMES=

# Cost tracking. Tokens are always counted; dollar cost is shown only if you set BOTH prices (USD per MILLION tokens).
# We do not guess prices: copy the current rates for your model from your provider's pricing page.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=

# A human-readable tag stored with every evaluation run, e.g. "v2-stricter-chest-pain". Prompts are ALSO fingerprinted
# automatically (a hash of their text), so a change is tracked even if you forget to update this.
PROMPT_VERSION_LABEL=

# How many days to keep call/analysis telemetry (timings, token counts and outcome labels only; never user text). Default 90.
TELEMETRY_RETENTION_DAYS=90

# Where evaluation datasets, saved runs and reference images live. Default: <project>/evaluation
# EVAL_DIR=/absolute/path/to/evaluation


# -----------------------------------------------------------------------------
# 7. DATA RETENTION, MAINTENANCE AND BACKUPS  [OPTIONAL]
# -----------------------------------------------------------------------------
# How long saved checks and chats are kept for people who have not chosen (days; 0 = until they delete them). Default 365.
# Each person can pick 30 / 90 / 365 days or "until I delete it" in Account settings.
DEFAULT_RETENTION_DAYS=365
# An operator ceiling nobody can exceed (0 = none). Example: 730 means nothing is ever kept longer than two years.
HISTORY_MAX_RETENTION_DAYS=0
# Uploaded photos are deleted immediately after analysis; a file still on disk after this many minutes is a crash leftover and is swept.
UPLOAD_MAX_AGE_MINUTES=30
# How often the automatic clean-up (retention, leftover photos, expired tokens and interviews) runs. It runs once per interval across all workers.
MAINTENANCE_INTERVAL_HOURS=24

# Where database backups go (default: a "backups" folder next to the database) and how many scheduled backups to keep.
# Backups hold password hashes and 2FA secrets: keep them private. The encryption key is NOT in a backup. Store it separately.
BACKUP_DIR=
BACKUP_KEEP=14

# Expose the API documentation (/api/docs, /api/openapi.json) to every signed-in user instead of admins only.
API_DOCS_PUBLIC=false


# -----------------------------------------------------------------------------
# 8. SECURITY, PRIVACY, MONITORING AND DEPLOYMENT  [OPTIONAL]
# -----------------------------------------------------------------------------
# Nothing leaves the server for the external AI provider (Google Gemini) until a person agrees. Set to false ONLY if you have another lawful basis.
REQUIRE_AI_CONSENT=true
# Sign people out after this many idle minutes / this many hours in total.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
# Key rotation: old key material that must still decrypt (comma-separated). See docs/SECURITY.md for the exact procedure, then run
#   python -m quickaid.core.rekey
CHAT_ENCRYPTION_KEY_PREVIOUS=
# Where the log of deletions is kept (default: next to the database). Lets a backup restore re-apply deletions.
DELETION_LOG=
# "json" = one JSON object per log line, for log aggregators.
LOG_FORMAT=
# Prometheus scraping: send "Authorization: Bearer <this>" to /metrics. Leave empty to allow admins only.
METRICS_TOKEN=
# Production error reporting. Empty = off. When on, NO personal data, request bodies, cookies or variables are sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
APP_ENV=production
APP_VERSION=
# /ready reports "not ready" below this much free disk (MB).
MIN_FREE_DISK_MB=100
# gunicorn (see deploy/gunicorn.conf.py)
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=90

# -----------------------------------------------------------------------------
# 9. SPEED OF AI RESULTS  [OPTIONAL]
# -----------------------------------------------------------------------------
# Every call to the AI model has a hard time limit. If it is hit, the built-in check (with first-aid steps) is shown straight away instead of waiting.
GEMINI_TIMEOUT_SECONDS=25
# Total time one check may spend waiting on the model across its attempts (a call that TIMED OUT is never retried; quick errors like 503 are, once).
GEMINI_TOTAL_BUDGET_SECONDS=40
# Flash models "think" for seconds before answering. These tasks are structured and safety-checked afterwards, so thinking is OFF by default.
# Set to "default" to restore the model's own behaviour, or a number to give it a token budget.
GEMINI_THINKING_BUDGET=
# true = ask the model to tailor the interview questions (adds one model round-trip BEFORE the first question; the built-in question bank is instant).
INTERVIEW_AI_PLAN=false
