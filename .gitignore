# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Uploaded files (runtime, not source)
uploads/*
!uploads/.gitkeep

# TLS certs/keys (generated locally or provisioned in production - never commit)
deploy/nginx/certs/*
!deploy/nginx/certs/.gitkeep

# Database and logs (runtime data, not source)
data/*
!data/.gitkeep
*.db
logs/*
!logs/.gitkeep

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.vscode/
.idea/

# Evaluation: licensed or personal reference photos stay out of git (the manifest and README are shared)
evaluation/reference/images/
evaluation/reference/manifest.json

# --- secrets and private data: never commit these (scripts/secret_scan.py enforces it) ---
.env.local
.env.production
*.env
!.env.example
.data_key
*.pem
*.key
*.p12
credentials.json
service-account*.json
data/backups/
backups/
*.db-wal
*.db-shm
*.db.gz
*.deletions.log
.sentry-native/
